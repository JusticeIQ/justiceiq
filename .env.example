# Supabase project configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only key, used exclusively in server components / route handlers.
# Never expose this to the browser or prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Force seeded demo mode even if Supabase credentials are present.
NEXT_PUBLIC_FORCE_DEMO_MODE=false

NEXT_PUBLIC_APP_URL=http://localhost:3000

# JusticeChamp <-> JusticeIQ integration (see docs/INTEGRATION_SPEC.md)
# Shared secret used to verify inbound referral webhooks from JusticeChamp.
JUSTICECHAMP_WEBHOOK_SECRET=replace-with-a-long-random-value
# Base URL of the JusticeChamp consumer app, used to build "view original
# report" deep links from a referral.
NEXT_PUBLIC_JUSTICECHAMP_APP_URL=https://justicechamp.example.com
